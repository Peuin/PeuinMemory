<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="54"
        android:translateY="54">
        <!-- Main compass / travel kite emblem inside 66dp safe zone (radius 30) -->
        <!-- North-East Wing (Bright Cyan) -->
        <path
            android:pathData="M 0,-28 L 18,-6 L 0,0 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="0"
                    android:startY="-28"
                    android:endX="18"
                    android:endY="0"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#38BDF8" />
                    <item android:offset="1.0" android:color="#0284C7" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- North-West Wing (Bright Coral / Orange highlight) -->
        <path
            android:pathData="M 0,-28 L -18,-6 L 0,0 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="0"
                    android:startY="-28"
                    android:endX="-18"
                    android:endY="0"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FB923C" />
                    <item android:offset="1.0" android:color="#EA580C" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- South-West Wing (Teal) -->
        <path
            android:pathData="M 0,28 L -18,-6 L 0,0 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="0"
                    android:startY="28"
                    android:endX="-18"
                    android:endY="-6"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#0D9488" />
                    <item android:offset="1.0" android:color="#14B8A6" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- South-East Wing (Deep Ocean) -->
        <path
            android:pathData="M 0,28 L 18,-6 L 0,0 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="0"
                    android:startY="28"
                    android:endX="18"
                    android:endY="-6"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#0369A1" />
                    <item android:offset="1.0" android:color="#38BDF8" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Center core glowing pin -->
        <path
            android:pathData="M 0,0 m -4,0 a 4,4 0 1,0 8,0 a 4,4 0 1,0 -8,0"
            android:fillColor="#FFFFFF" />
        <!-- Orbiting travel ring -->
        <path
            android:pathData="M -22,-6 C -22,-18 22,-18 22,-6 C 22,6 -22,6 -22,-6 Z"
            android:strokeWidth="2"
            android:strokeColor="#FFFFFF"
            android:fillColor="#00000000" />
    </group>
</vector>
